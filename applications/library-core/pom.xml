<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- grade-checker-core: domain of Grade Checker (grades per milestone, author attribution, periods, groups) and the
         GitHub client, shared by the monolith (applications/monolith) and the serverless version (applications/serverless/lambda).
         Independent project: it does not inherit from the applications. Spec: openspec/ (this folder). Plan: plan.md. -->
    <groupId>br.com.gradechecker</groupId>
    <artifactId>grade-checker-core</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>grade-checker-core</name>
    <description>Domain and GitHub client of Grade Checker, shared by its Jetty and serverless versions</description>
    <url>https://github.com/professor-enoqueleal/grade-checker</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Java 11 bytecode: runs on the Jetty version (Java 11) and on the Lambda (Java 21) -->
        <maven.compiler.release>11</maven.compiler.release>

        <unirest.version>3.14.1</unirest.version>
        <gson.version>2.10</gson.version>

        <junit.version>4.13.2</junit.version>
        <mockito.version>5.11.0</mockito.version>
        <wiremock.version>2.35.1</wiremock.version>
        <system.rules.version>1.19.0</system.rules.version>
    </properties>

    <dependencies>
        <!-- only the package br.com.gradechecker.core.github uses these two (checked by ArchitectureTest) -->
        <dependency>
            <groupId>com.konghq</groupId>
            <artifactId>unirest-java</artifactId>
            <version>${unirest.version}</version>
        </dependency>

        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>

        <!-- tests: never reach the applications -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.github.tomakehurst</groupId>
            <artifactId>wiremock-jre8</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.github.stefanbirkner</groupId>
            <artifactId>system-rules</artifactId>
            <version>${system.rules.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- system-rules changes environment variables by reflection -->
                    <argLine>--add-opens java.base/java.util=ALL-UNNAMED --add-opens java.base/java.lang=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
            <!-- sources jar: the IDE shows the code of the library when navigating -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals><goal>jar-no-fork</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- mvn deploy (tag core-vX.Y.Z, .github/workflows/core-release.yml) -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/professor-enoqueleal/grade-checker</url>
        </repository>
    </distributionManagement>
</project>
