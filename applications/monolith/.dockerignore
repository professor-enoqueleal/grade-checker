# keep the build context small: only pom, wrapper and src are needed
# (grade-checker-core comes from the separate build context "core" = ../library-core)
.git
.idea
*.iml
target
e2e
# CloudFormation template of the EC2 (not used by the image)
grade-checker-ec2.yaml
# local secrets (GitHub App client secret): never sent to the Docker build
.env.local
**/.DS_Store
