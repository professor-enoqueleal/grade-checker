# Configuration of docker compose (copy to .env, which stays out of Git). Every value is optional.
# GitHub logins of the administrators, comma separated (Manage groups, Class grades, Manage members)
GRADE_CHECKER_ADMINS=your-github-login
# GitHub App for "Continue with GitHub" (callback: http://localhost:5173/api/auth/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
